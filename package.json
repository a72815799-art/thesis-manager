{
  "name": "thesis-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "한국어 상담·심리 대학원생용 논문 연구관리 웹앱 (로컬 우선 MVP)",
  "scripts": {
    "dev": "vite",
